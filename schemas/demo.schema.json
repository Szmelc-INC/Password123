{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szmelc-inc.github.io/Password123/schemas/demo.schema.json",
  "title": "Password123 demo manifest",
  "description": "Demo payloads are encrypted only to the published demo recipient and contain no real answers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "recipient", "payloads"],
  "properties": {
    "schema_version": { "const": 1 },
    "identity": { "const": "demo/demo-identity.txt" },
    "recipient": { "type": "string", "pattern": "^age1[02-9ac-hj-np-z]{58}$" },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "path", "format", "sha256", "plaintext_sha256", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^demo-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^payloads/demo-[a-z0-9-]+\\.age$" },
          "format": { "enum": ["application/json", "text/plain", "text/markdown"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "plaintext_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "label": { "const": "demo-only" }
        }
      }
    }
  }
}
