{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szmelc-inc.github.io/Password123/schemas/vectors.schema.json",
  "title": "Password123 public test vector file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lesson_id", "algorithm", "vectors"],
  "properties": {
    "schema_version": { "const": 1 },
    "lesson_id": { "type": "string", "pattern": "^0[1-6]-[a-z0-9]+(-[a-z0-9]+)*$" },
    "algorithm": { "type": "string", "minLength": 1 },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "verifier", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "kind": { "enum": ["official", "reference-implementation", "community", "adapted", "parameter", "property"] },
          "status": { "enum": ["verified", "unverified"] },
          "verifier": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document", "url"],
            "properties": {
              "document": { "type": "string", "minLength": 1 },
              "section": { "type": "string" },
              "test_case": { "type": "string" },
              "url": { "type": "string", "pattern": "^https://" }
            }
          },
          "params": { "$ref": "#/$defs/values" },
          "inputs": { "$ref": "#/$defs/values" },
          "expected": { "$ref": "#/$defs/values" },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "values": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "value": {
      "description": "Every value names exactly one encoding.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "hex": { "type": "string", "pattern": "^[0-9A-Fa-f :\\n]*$" },
        "utf8": { "type": "string" },
        "base64": { "type": "string" },
        "int": { "type": "integer" },
        "dec": { "type": "string", "pattern": "^[0-9 \\n]+$" },
        "pattern251": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
