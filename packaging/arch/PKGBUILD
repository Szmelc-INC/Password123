# Maintainer: Szmelc-INC <https://github.com/Szmelc-INC>
pkgname=password123
pkgver=0.1.1
pkgrel=1
pkgdesc="Zero-knowledge cryptography lab CLI/TUI: lessons, verified test vectors, age-encrypted challenges (p123)"
arch=('x86_64' 'aarch64')
url="https://github.com/Szmelc-INC/Password123"
license=('MIT')
depends=('glibc')
makedepends=('go' 'git')
optdepends=('age: reference age CLI' 'sops: edit private-cli/*.sops.yaml')
provides=('p123')
source=("$pkgname::git+https://github.com/Szmelc-INC/Password123.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  export CGO_CPPFLAGS="${CPPFLAGS}" CGO_CFLAGS="${CFLAGS}" CGO_CXXFLAGS="${CXXFLAGS}" CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X github.com/Szmelc-INC/Password123/internal/cli.Version=v$pkgver" -o p123 ./cmd/p123
}

check() {
  cd "$pkgname"
  go test ./internal/vectors/ ./internal/vault/
}

package() {
  cd "$pkgname"
  install -Dm755 p123 "$pkgdir/usr/bin/p123"
  install -Dm644 completions/p123.bash "$pkgdir/usr/share/bash-completion/completions/p123"
  install -Dm644 completions/_p123 "$pkgdir/usr/share/zsh/site-functions/_p123"
  install -Dm644 completions/p123.fish "$pkgdir/usr/share/fish/vendor_completions.d/p123.fish"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md ARCHITECTURE.md CONTRIBUTING.md SECURITY.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
